#:kivy 2.3.0

# --------------------------------------------------
# COMPONENT STYLES
# --------------------------------------------------

<CompactSpinnerOption@SpinnerOption>:
    background_normal: ""
    background_color: (.16, .19, .26, 1)
    color: (.92, .94, .98, 1)
    height: dp(38)
    font_size: '13sp'

<CompactDropDown>:
    max_height: dp(220)
    canvas.before:
        Color:
            rgba: (.12, .14, .19, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

<TaskCard>:
    size_hint_y: None
    height: dp(52)
    spacing: 8
    padding: [10, 6, 10, 6]
    canvas.before:
        Color:
            rgba: (.13, .15, .20, 0.7) if self.completed else (.16, .18, .25, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
        Color:
            rgba: (.22, .26, .35, 0.3) if self.completed else (.24, .28, .38, 0.6)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
            width: 1

<EmptyTaskCard@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(100)
    padding: [16, 18, 16, 18]
    spacing: 6
    canvas.before:
        Color:
            rgba: (.13, .15, .20, 0.5)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]
        Color:
            rgba: (.25, .30, .40, 0.35)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
            width: 1

    Label:
        text: "No tasks for today 🎯"
        font_size: '15sp'
        bold: True
        color: (.75, .80, .90, 1)

    Label:
        text: "Nothing pending. Enjoy your day! ✨"
        font_size: '12sp'
        color: (.50, .55, .65, 1)


# --------------------------------------------------
# HOME / CALENDAR SCREEN
# --------------------------------------------------

<HomeScreen>:

    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 16

        canvas.before:
            Color:
                rgb: (.06, .07, .09)
            Rectangle:
                pos: self.pos
                size: self.size

        # ---------- HEADER ----------
        BoxLayout:
            size_hint_y: None
            height: 60
            spacing: 12

            # Brand / Active Month Title
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.38
                spacing: 2

                Label:
                    id: month_title
                    text: "Month Year"
                    font_size: '26sp'
                    bold: True
                    halign: "left"
                    valign: "middle"
                    color: 1, 1, 1, 1
                    text_size: self.size

                Label:
                    text: "Personal Journal & Planner"
                    font_size: '12sp'
                    color: (.50, .55, .65, 1)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

            Widget: # Spacer

            # Navigation Controls
            BoxLayout:
                size_hint_x: None
                width: self.minimum_width
                spacing: 8

                # Quick Jump "Today" Button
                Button:
                    text: "Today"
                    size_hint: None, None
                    size: 72, 38
                    background_normal: ""
                    background_color: (.22, .26, .36, 1)
                    color: (.92, .94, .98, 1)
                    bold: True
                    font_size: '13sp'
                    on_press: root.go_today()

                # Month Navigator: [<] [Month Spinner] [>]
                BoxLayout:
                    size_hint: None, None
                    size: 195, 38
                    spacing: 2
                    canvas.before:
                        Color:
                            rgba: (.13, .16, .22, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
                        Color:
                            rgba: (.22, .26, .36, 0.5)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                            width: 1

                    Button:
                        text: "‹"
                        font_size: '20sp'
                        bold: True
                        size_hint: None, 1
                        width: 32
                        background_normal: ""
                        background_color: (0, 0, 0, 0)
                        color: (.75, .80, .92, 1)
                        on_press: root.prev_month()

                    Spinner:
                        id: month_spinner
                        text: "January"
                        values: root.months
                        size_hint: 1, 1
                        background_normal: ""
                        background_color: (0, 0, 0, 0)
                        color: (1, 1, 1, 1)
                        bold: True
                        font_size: '13sp'
                        dropdown_cls: 'CompactDropDown'
                        option_cls: 'CompactSpinnerOption'
                        on_text: root.on_month_selected(self.text)

                    Button:
                        text: "›"
                        font_size: '20sp'
                        bold: True
                        size_hint: None, 1
                        width: 32
                        background_normal: ""
                        background_color: (0, 0, 0, 0)
                        color: (.75, .80, .92, 1)
                        on_press: root.next_month()

                # Year Navigator: [<] [Year Spinner] [>]
                BoxLayout:
                    size_hint: None, None
                    size: 145, 38
                    spacing: 2
                    canvas.before:
                        Color:
                            rgba: (.13, .16, .22, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
                        Color:
                            rgba: (.22, .26, .36, 0.5)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                            width: 1

                    Button:
                        text: "‹"
                        font_size: '20sp'
                        bold: True
                        size_hint: None, 1
                        width: 30
                        background_normal: ""
                        background_color: (0, 0, 0, 0)
                        color: (.75, .80, .92, 1)
                        on_press: root.prev_year()

                    Spinner:
                        id: year_spinner
                        text: "2026"
                        values: ["2026"]
                        size_hint: 1, 1
                        background_normal: ""
                        background_color: (0, 0, 0, 0)
                        color: (.42, .65, 1, 1)
                        bold: True
                        font_size: '14sp'
                        dropdown_cls: 'CompactDropDown'
                        option_cls: 'CompactSpinnerOption'
                        on_text: root.on_year_selected(self.text)

                    Button:
                        text: "›"
                        font_size: '20sp'
                        bold: True
                        size_hint: None, 1
                        width: 30
                        background_normal: ""
                        background_color: (0, 0, 0, 0)
                        color: (.75, .80, .92, 1)
                        on_press: root.next_year()

        # ---------- CALENDAR CARD ----------
        BoxLayout:
            padding: 16

            canvas.before:
                Color:
                    rgb: (.11, .13, .17)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]
                Color:
                    rgba: (.20, .24, .32, 0.4)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 16)
                    width: 1

            GridLayout:
                id: calendar_grid
                cols: 7
                spacing: 8
                padding: 6


# --------------------------------------------------
# DIARY & TO-DO SCREEN
# --------------------------------------------------

<DiaryScreen>:

    BoxLayout:
        padding: 20
        spacing: 16

        canvas.before:
            Color:
                rgb: (.06, .07, .09)
            Rectangle:
                pos: self.pos
                size: self.size

        # ---------- DIARY PANEL ----------
        BoxLayout:
            orientation: "vertical"
            spacing: 12
            padding: 16

            canvas.before:
                Color:
                    rgb: (.11, .13, .17)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]
                Color:
                    rgba: (.20, .24, .32, 0.4)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 16)
                    width: 1

            # Header row
            BoxLayout:
                size_hint_y: None
                height: 38
                spacing: 10

                Label:
                    id: diary_title
                    text: "Diary"
                    font_size: '22sp'
                    bold: True
                    halign: "left"
                    valign: "middle"
                    color: 1, 1, 1, 1
                    text_size: self.size

                Widget:

                Label:
                    id: save_feedback
                    text: ""
                    font_size: '13sp'
                    color: (.35, .82, .52, 1)
                    bold: True
                    size_hint_x: None
                    width: 80

            # Multiline Text Editor with Placeholder (Feature 2)
            TextInput:
                id: editor
                multiline: True
                background_normal: ""
                background_color: (.15, .17, .22, 1)
                foreground_color: (.95, .96, .98, 1)
                hint_text_color: (.48, .53, .63, 0.8)
                cursor_color: (.38, .55, .95, 1)
                padding: [16, 16, 16, 16]
                font_size: '15sp'
                selection_color: (.3, .5, .8, 0.4)

            # Footer Action Buttons
            BoxLayout:
                size_hint_y: None
                height: 46
                spacing: 12

                Button:
                    id: save_btn
                    text: "Save Entry"
                    background_normal: ""
                    background_color: (.28, .48, .90, 1)
                    color: (1, 1, 1, 1)
                    font_size: '14sp'
                    bold: True
                    size_hint_x: 0.5
                    on_press: root.save()

                Button:
                    text: "Back to Calendar"
                    background_normal: ""
                    background_color: (.20, .23, .30, 1)
                    color: (.88, .90, .95, 1)
                    font_size: '14sp'
                    bold: True
                    size_hint_x: 0.5
                    on_press: root.go_home()

        # ---------- TO-DO PANEL (Feature 3) ----------
        BoxLayout:
            orientation: "vertical"
            size_hint_x: .38
            spacing: 12
            padding: 16

            canvas.before:
                Color:
                    rgb: (.11, .13, .17)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]
                Color:
                    rgba: (.20, .24, .32, 0.4)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 16)
                    width: 1

            # Header
            Label:
                text: "To-Do List"
                font_size: '22sp'
                bold: True
                size_hint_y: None
                height: 38
                halign: "left"
                valign: "middle"
                color: 1, 1, 1, 1
                text_size: self.size

            # Task Creation Bar / Card
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 90
                spacing: 8
                padding: [10, 10, 10, 10]
                canvas.before:
                    Color:
                        rgba: (.15, .17, .23, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                    Color:
                        rgba: (.24, .28, .38, 0.4)
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                        width: 1

                TextInput:
                    id: task_input
                    hint_text: "Add a task..."
                    hint_text_color: (.48, .53, .63, 0.8)
                    background_normal: ""
                    background_color: (.10, .12, .16, 1)
                    foreground_color: (1, 1, 1, 1)
                    cursor_color: (.38, .55, .95, 1)
                    size_hint_y: None
                    height: 32
                    font_size: '13sp'
                    padding: [10, 6, 10, 6]
                    multiline: False
                    on_text_validate: root.add_task()

                BoxLayout:
                    size_hint_y: None
                    height: 30
                    spacing: 8

                    Spinner:
                        id: priority_spinner
                        text: "Medium"
                        values: ["High", "Medium", "Low"]
                        size_hint_x: None
                        width: 105
                        background_normal: ""
                        background_color: (.20, .24, .33, 1)
                        color: (1, 1, 1, 1)
                        font_size: '12sp'
                        bold: True
                        dropdown_cls: 'CompactDropDown'
                        option_cls: 'CompactSpinnerOption'

                    Widget: # Spacer

                    Button:
                        text: "+ Add"
                        bold: True
                        font_size: '13sp'
                        size_hint_x: None
                        width: 75
                        background_normal: ""
                        background_color: (.32, .48, .92, 1)
                        color: (1, 1, 1, 1)
                        on_press: root.add_task()

            # Task List Container
            ScrollView:
                bar_width: 6
                bar_color: (.35, .42, .55, 0.6)
                bar_inactive_color: (.25, .30, .40, 0.3)

                GridLayout:
                    id: tasks_container
                    cols: 1
                    spacing: 8
                    size_hint_y: None
                    height: self.minimum_height
